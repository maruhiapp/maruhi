{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Static Assets によるビルド成果物の配信検証(サーバーコードなし)。
  // CSP 等のヘッダは public/_headers(ビルドで dist/public にコピーされる)で付与する。
  "name": "maruhi-web",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    // 既定値の明示ピン(裁定 BH): /invite → invite.html の解決(拡張子なし正規 URL —
    // AUTH_SPEC §15-3)がこの値に依存する。既定変更で /invite が SPA フォールバックに
    // 落ちる形を、既定依存でなく構成にする
    "html_handling": "auto-trailing-slash",
  },
}
