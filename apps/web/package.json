{
  "name": "@maruhi/web",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "build": "vp build && bun run scripts/write-headers.ts",
    "dev": "vp dev",
    "doctor": "react-doctor . --blocking warning --no-telemetry",
    "doctor:astryx": "astryx doctor",
    "e2e": "vp test run",
    "preview": "cd ../server && bun x cf dev --port 8788",
    "screenshots": "bun run test/screenshots.ts",
    "theme:build": "astryx theme build theme/maruhi.ts -o theme/maruhi.css"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@funstack/router": "1.6.0",
    "@funstack/static": "1.3.4",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.15",
    "@astryxdesign/cli": "0.7.15",
    "@babel/core": "8.1.2",
    "@maruhi/api-schema": "workspace:*",
    "@maruhi/crypto": "workspace:*",
    "@stylexjs/babel-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "effect": "4.1.4",
    "playwright": "1.65.0",
    "react-doctor": "0.9.23",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "wrangler": "4.152.0"
  },
  "astryx": {
    "theme": "./theme/maruhi.ts"
  }
}
