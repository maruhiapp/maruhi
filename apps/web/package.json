{
  "name": "@maruhi/web",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && bun run scripts/write-headers.ts",
    "dev": "vite dev",
    "doctor": "react-doctor . --scope changed --no-telemetry",
    "doctor:astryx": "astryx doctor",
    "e2e": "vitest run",
    "preview": "wrangler dev --config ../server/wrangler.jsonc --port 8788",
    "screenshots": "bun run test/screenshots.ts",
    "theme:build": "astryx theme build theme/maruhi.ts -o theme/maruhi.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.2",
    "@astryxdesign/theme-neutral": "0.5.2",
    "@funstack/router": "1.4.0",
    "@funstack/static": "1.3.1",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.5.2",
    "@astryxdesign/cli": "0.5.2",
    "@babel/core": "8.0.1",
    "@maruhi/api-schema": "workspace:*",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "6.1.1",
    "effect": "4.0.0-rc.112",
    "playwright": "1.62.1",
    "react-doctor": "0.9.13",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "astryx": {
    "theme": "./theme/maruhi.ts"
  }
}
