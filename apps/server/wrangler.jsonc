{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ADR-0012 のセルフホスト経路: 素の wrangler 設定のみでデプロイできること。
  "name": "maruhi-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // workers.dev サブドメインで公開する(セルフホストの既定 URL。独自ドメインを
  // routes で割り当てる場合も OAuth コールバック URL は origin から導出される)
  "workers_dev": true,
  // バージョンごとのプレビュー URL は無効化: 認証エンドポイントの origin を
  // 増やさない(OAuth コールバックはデプロイ URL 1 つに固定する)
  "preview_urls": false,
  // Web ダッシュボード(apps/web)のビルド出力を同一 Worker から配信する
  // (W2 — 裁定 BM: docs/notes/session-43.md)。セッションクッキー(__Host-)・
  // CSP connect-src 'self'・OAuth callback(${origin}/)のいずれも
  // ダッシュボードと API の同一オリジンを要求するため、単一 Worker に同梱する。
  // `bun run deploy` が web ビルドを前置する(アセット欠落の deploy は
  // wrangler がディレクトリ不在で落ちる — 黙って API 単体にならない)
  "assets": {
    "directory": "../web/dist/public",
    // API のパス空間(api-schema の全エンドポイント = /auth・/projects・
    // /invites 前置)は常に Worker へ。SPA のルート空間(/dashboard 等)とは
    // 素で分離されている(裁定 BO)。列挙外はアセット層(_headers /
    // _redirects / SPA フォールバック — apps/web と同一の配信意味論)。
    // /invites/*(受諾 POST — §15-2)は必須: 列挙しないと _redirects の
    // /invite* 総取り(session-41 BF)が POST ごと 301 で飲む(実測 —
    // session-43 §9 の欠陥修正)
    "run_worker_first": ["/auth/*", "/projects", "/projects/*", "/invites", "/invites/*"],
    "not_found_handling": "single-page-application",
    // 既定値の明示ピン(session-41 裁定 BH): /invite → invite.html の拡張子なし
    // 正規 URL(AUTH_SPEC §15-3)がこの値に依存する。既定変更への暗黙依存を
    // 構成にする
    "html_handling": "auto-trailing-slash",
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_CHAIN", "class_name": "ProjectChainDO" }],
  },
  // 発信元 IP 単位の best-effort レート制限(deepsec M5/R7・AUTH_SPEC §4-1)。
  // 全プランで使える per-colo のメモリベース制限で、既定デプロイでも未認証の
  // 高コスト面(CLI ログインの start / poll・OAuth callback の GitHub 呼び出し・
  // lease の DO 生成)を有界にする。
  // period は 10 か 60 のみで、変更時は src/worker-env.ts の
  // IP_RATE_LIMIT_PERIOD_SECONDS(429 の retryAfterSeconds)も揃えること。
  // 値は docs/SELF_HOSTING.md の WAF 推奨値と同一。共有 egress(オフィス NAT・
  // 共有ランナー)配下で正当なトラフィックが 429 になる場合は limit を上げる
  // (per-colo 計数なので実効上限は名目より緩い)。より強い保全(グローバル
  // 計数)は引き続き同ドキュメントの WAF ルールを推奨
  "ratelimits": [
    // CLI ログイン start(AUTH_SPEC §4-1 (1) 起草値 10 回/分/IP)
    {
      "name": "CLI_START_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "LEASE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // callback はブラウザの対話ログイン経路(CLI ブラウザ脚含む)。同一オフィス
    // NAT からの同時ログインが束になるため start(10)より緩くする(deepsec R7)
    {
      "name": "OAUTH_CALLBACK_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    // CLI ログイン poll(AUTH_SPEC §4-1 (5) — 正常系は 5 秒間隔 = 12 回/分。
    // 複数フローの併走・時計ずれの余裕を見て 30/min)
    {
      "name": "CLI_POLL_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
    // サインアップ招待コード付き start の事前検証(AUTH_SPEC §3 — 2026-09-01 H1。
    // コード付き start だけが対象 — プレーンなログイン導線は制限なし)
    {
      "name": "SIGNUP_START_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectChainDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maruhi",
      // セルフホスト: `wrangler d1 create maruhi` で得た ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
      // drizzle-kit v1 のフォルダ形式(drizzle/<name>/migration.sql)
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  // GitHub OAuth App の GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET は両方とも
  // Workers Secret として登録する(`wrangler secret put` — 手順は
  // docs/SELF_HOSTING.md)。client_id は公開情報だが、登録経路を secret に
  // 統一することでこのファイルの編集(フォークへのコミット)と再デプロイを
  // 不要にしている(AUTH_SPEC §3-2)。未登録のまま立てたサーバーは認証系
  // エンドポイントが 503 SetupIncomplete を返す(handlers-auth.ts)
  "triggers": {
    // 期限切れセッション行の掃除(提示されない行は resolve 時の掃除では消えない)
    "crons": ["17 3 * * *"],
  },
}
