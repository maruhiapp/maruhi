{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maruhi-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist/public",
    "run_worker_first": ["/auth/*", "/projects", "/projects/*", "/invites", "/invites/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_CHAIN", "class_name": "ProjectChainDO" }],
  },
  "ratelimits": [
    {
      "name": "CLI_START_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "LEASE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "OAUTH_CALLBACK_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "CLI_POLL_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SIGNUP_START_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "CLI_VERIFY_RATE_LIMIT",
      "namespace_id": "1006",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "CLI_APPROVE_RATE_LIMIT",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "exports": {
    "ProjectChainDO": { "type": "durable-object", "storage": "sqlite" },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maruhi",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *", "23 * * * *"],
  },
  "env": {
    "hosted": {
      "routes": [{ "pattern": "my.maruhi.app", "custom_domain": true }],
      "workers_dev": false,
      "durable_objects": {
        "bindings": [{ "name": "PROJECT_CHAIN", "class_name": "ProjectChainDO" }],
      },
      "ratelimits": [
        {
          "name": "CLI_START_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "LEASE_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "OAUTH_CALLBACK_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "CLI_POLL_RATE_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "SIGNUP_START_RATE_LIMIT",
          "namespace_id": "1005",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "CLI_VERIFY_RATE_LIMIT",
          "namespace_id": "1006",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "CLI_APPROVE_RATE_LIMIT",
          "namespace_id": "1007",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maruhi",
          "database_id": "c45d4f84-3142-46cf-ab3b-c9571ca7eed0",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*/migration.sql",
        },
      ],
      "r2_buckets": [{ "binding": "OPS_BACKUP_BUCKET", "bucket_name": "maruhi-ops-backup" }],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
      },
      "limits": { "cpu_ms": 300000 },
    },
  },
}
