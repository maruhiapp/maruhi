{
  "name": "@maruhi/server",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "bun run db:migrate && bun run web:build && wrangler deploy",
    "deploy:dry-run": "bun run web:build && wrangler deploy --dry-run",
    "web:build": "bun run --filter @maruhi/web build",
    "db:create": "wrangler d1 create maruhi",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@maruhi/api-schema": "workspace:*",
    "@maruhi/core": "workspace:*",
    "@maruhi/crypto": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260901.1",
    "drizzle-kit": "1.0.0-rc.4",
    "wrangler": "4.127.1"
  }
}
