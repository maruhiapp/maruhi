{
  "name": "@maruhi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "bun run db:migrate && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:create": "wrangler d1 create maruhi",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@maruhi/api-schema": "workspace:*",
    "@maruhi/core": "workspace:*",
    "@maruhi/crypto": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260731.1",
    "drizzle-kit": "1.0.0-rc.4",
    "wrangler": "4.118.0"
  }
}
