{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Restore worker (operations-only, non-HTTP, not permanently deployed —
  // docs/notes/hosted-ops.md §2-E / §5-2). Deploy it only during restore work
  // with `wrangler deploy -c wrangler.restore.jsonc`, then remove it with
  // `wrangler delete -c wrangler.restore.jsonc`. It has no HTTP handler
  // (workers.dev is also disabled); its only job is a per-minute cron that
  // reads restore/jobs/ in the evacuation bucket.
  "name": "maruhi-restore",
  "main": "src/restore-worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      // The production worker's DO namespace (bound via script_name). The
      // receiving RPC (opsRestore) writes only to empty DOs. A wrangler named
      // environment publishes a separate Worker called `<name>-<env>`, so the
      // entity behind `wrangler deploy --env hosted` is `maruhi-server-hosted`
      // (the top-level `maruhi-server` is the self-host default — operations
      // does not deploy it). scripts/check-hosted-config.ts cross-checks the
      // effective name of env.hosted against this
      {
        "name": "PRODUCTION_PROJECT_CHAIN",
        "class_name": "ProjectChainDO",
        "script_name": "maruhi-server-hosted",
      },
      // Namespace for drills — a separate class inside this worker (does not
      // intersect with production)
      { "name": "DRILL_PROJECT_CHAIN", "class_name": "RestoreDrillDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RestoreDrillDO"] }],
  "r2_buckets": [{ "binding": "OPS_BACKUP_BUCKET", "bucket_name": "maruhi-ops-backup" }],
  // The restore-destination DO (drill) runs the same code as ProjectChainDO, so
  // the production Secrets (SERVER_ENC_KEY_IKM etc.) are not needed — restore
  // only writes back to DO SQLite and derives the audit head; it never passes
  // through paths that use keys (leases)
  "triggers": { "crons": ["* * * * *"] },
  "limits": { "cpu_ms": 300000 },
}
