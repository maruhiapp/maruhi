{
  "name": "@maruhi/site",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "build": "astro build && bun run scripts/postbuild.ts",
    "deploy": "bun run build && CLOUDFLARE_DEPENDENCIES_INSTRUMENTATION=false cf deploy --no-provision dist",
    "dev": "astro dev",
    "sync": "astro sync",
    "e2e": "vp test run",
    "preview": "bun run build && bun run scripts/preview.ts",
    "theme:build": "bun run scripts/build-theme.ts",
    "validate": "nimbus-docs lint"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.20.0",
    "@iconify-json/ph": "1.2.2",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.12",
    "clsx": "2.1.1",
    "satori": "0.63.2",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.31",
    "pagefind": "1.6.0",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "wrangler": "4.161.0"
  }
}
