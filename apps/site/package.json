{
  "name": "@maruhi/site",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "build": "bunx --bun blume build && bun run scripts/postbuild.ts",
    "deploy": "bun run build && CLOUDFLARE_DEPENDENCIES_INSTRUMENTATION=false cf deploy --no-provision",
    "dev": "bunx --bun blume dev",
    "e2e": "vp test run",
    "preview": "cf dev --port 8789",
    "theme:build": "bun run scripts/build-theme.ts",
    "validate": "bunx --bun blume validate --strict"
  },
  "dependencies": {
    "blume": "2.2.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.20",
    "playwright": "1.65.0",
    "wrangler": "4.152.0"
  }
}
