---
// LP(apex `maruhi.app/`)— Blume のカスタムページ(docs/notes/web-design-pass.md §4、裁定 D / G)。
//
// 構成は所有者レビュー(2026-09-04)後の案 A: ADR-0014 の勝ち文句「信じなくてよい相手の範囲が
// 競合より広い」を 1 本の主張にし、各節が構造でそれを証明する。
//   Hero(Not even us.)→ Who can read what(信頼境界の表)→ Nothing to leak from disk
//   → Agents get the contract → Your Cloudflare account → What we don't promise → Get started
// トーン(§2): ダーク基調・アクセント 1 色を限定的に・コード / ターミナルが主役・装飾控えめ・
// セキュリティは淡々と。書いていない機能は謳わない。ターミナルの出力行は実際の CLI 文字列
// (apps/cli/src — push / login / agent-gate / schema)から写す。
//
// スタイリングは scoped <style>(素の CSS)のみ。色は Blume の theme tokens(--blume-*)を参照し、
// 生 hex を書かない。間隔・寸法は先頭のカスタムプロパティに集約する(ADR-0013 の精神)。
// ユーザーに見える文言は英語(ADR-0017)。
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
const repo = "https://github.com/maruhiapp/maruhi";
const productOrigin = "https://my.maruhi.app";
const cryptoSpec = `${repo}/blob/main/docs/CRYPTO_SPEC.md`;
const title = "maruhi — secrets only you can read. Not even us.";

// 信頼境界の表(ADR-0018 / CRYPTO_SPEC §14.2)。「読める」のは復号器を持つ場所だけ
const trust = [
  {
    who: "Your CLI, on your machine",
    plaintext: true,
    how: "The only decryptor. MIT-licensed, so you can read it.",
  },
  {
    who: "The process you run with maruhi run",
    plaintext: true,
    how: "Values arrive as environment variables, in memory, for that process only.",
  },
  {
    who: "The server",
    plaintext: false,
    how: "Stores and relays ciphertext. Holds no key that could open it.",
  },
  {
    who: "The web dashboard",
    plaintext: false,
    how: "Read-only metadata. It ships no decryptor and never receives a key.",
  },
  {
    who: "Us, the operator of my.maruhi.app",
    plaintext: false,
    how: "Same ciphertext as everyone else. Nothing to hand over, nothing to leak.",
  },
  {
    who: "An AI agent in your terminal",
    plaintext: false,
    how: "Gets the schema. Value display is refused when an agent is detected.",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt="The maruhi mark (a vermilion 秘 in a circle) next to the word maruhi"
  ogImageSize={{ width: 1200, height: 630 }}
  page={{ title, description: config.description }}
>
  <div class="lp">
    <section class="hero" id="top">
      <p class="eyebrow">end-to-end encrypted secrets for teams · private preview</p>
      <h1>
        Secrets only you can read.
        <span class="punch">Not even us.</span>
      </h1>
      <p class="lede">
        maruhi encrypts every value on your machine before it leaves. The server, the dashboard,
        and the people running them only ever see ciphertext. The one thing that decrypts is an
        open-source CLI you can read.
      </p>
      <pre class="terminal" aria-label="Example maruhi session"><code><span class="prompt">$</span> maruhi push DATABASE_URL
<span class="out">Pushed DATABASE_URL (version=1, epoch=1)</span>
<span class="prompt">$</span> maruhi run -- bun start
<span class="comment"># DATABASE_URL is in this process's environment. Nowhere else.</span></code></pre>
      <p class="actions">
        <a class="button" href="#start">Get started</a>
        <a class="link" href="/docs">Read the docs</a>
        <a class="link" href={repo}>Source on GitHub</a>
      </p>
    </section>

    <section class="section" id="trust" aria-labelledby="trust-heading">
      <h2 id="trust-heading">Who can read your secrets</h2>
      <p>
        Most secrets managers encrypt at rest and decrypt on the server or in the browser. maruhi
        moves the decryptor to the one place you already control. Everything else is out of the
        loop by construction, not by policy.
      </p>
      <div class="table-wrap">
        <table class="trust">
          <thead>
            <tr>
              <th scope="col">Where</th>
              <th scope="col">Sees plaintext</th>
              <th scope="col">Why</th>
            </tr>
          </thead>
          <tbody>
            {
              trust.map((row) => (
                <tr>
                  <th scope="row">{row.who}</th>
                  <td class={row.plaintext ? "yes" : "no"}>{row.plaintext ? "yes" : "no"}</td>
                  <td>{row.how}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="fine">
        This is what "zero knowledge" means here: it is a property of the design, and the design is
        in the <a href={repo}>repository</a> — server, dashboard, CLI, and the crypto specification.
      </p>
    </section>

    <section class="section" id="diskless" aria-labelledby="diskless-heading">
      <h2 id="diskless-heading">Nothing to leak from disk</h2>
      <p>
        <code>maruhi run</code> decrypts in memory and hands values to your process as environment
        variables. When the process exits, they are gone. There is no <code>.env</code> writer, no
        value export, no "download as file" — not disabled, but absent. A tool that cannot write
        secrets to disk cannot be talked into it.
      </p>
      <pre class="terminal"><code><span class="prompt">$</span> maruhi run -- printenv DATABASE_URL | wc -c
<span class="out">42</span>
<span class="prompt">$</span> ls -a .env*
<span class="out">ls: .env*: No such file or directory</span></code></pre>
    </section>

    <section class="section" id="agents" aria-labelledby="agents-heading">
      <h2 id="agents-heading">Agents get the contract, not the values</h2>
      <p>
        A coding agent needs to know which variables exist, their types, and whether they are set. It
        does not need the values. <code>maruhi schema</code> returns exactly that, and the CLI refuses
        to display values when it detects it is not being run by a person at a terminal.
      </p>
      <pre class="terminal"><code><span class="prompt">$</span> maruhi schema
<span class="out">NAME          TYPE     REQUIRED  STATUS  DESCRIPTION
DATABASE_URL  url      true      set     Primary Postgres
STRIPE_KEY    string   true      set     -
SENTRY_DSN    string   false     set     -</span>
<span class="prompt">$</span> maruhi pull --show <span class="comment"># from inside an AI agent session</span>
<span class="err">maruhi: Refused to display values because an AI agent environment was detected. If you need to inspect a value, run this yourself on an interactive terminal</span></code></pre>
    </section>

    <section class="section" id="self-host" aria-labelledby="selfhost-heading">
      <h2 id="selfhost-heading">Your Cloudflare account. One deploy.</h2>
      <p>
        The whole server is one Worker with a D1 database and Durable Objects. No Postgres, no
        Redis, no VM to patch. It runs on the free plan, and the setup that is specific to maruhi is
        creating a GitHub OAuth App. About ten minutes.
      </p>
      <pre class="terminal"><code><span class="prompt">$</span> git clone {repo}.git && cd maruhi && bun install
<span class="prompt">$</span> bunx wrangler d1 create maruhi
<span class="prompt">$</span> bunx wrangler deploy</code></pre>
      <p class="actions">
        <a class="link" href="/docs/self-hosting">Self-hosting guide</a>
      </p>
    </section>

    <section class="section" id="honest" aria-labelledby="honest-heading">
      <h2 id="honest-heading">What we don't promise</h2>
      <p>
        Zero knowledge has edges, and we would rather you read them here than discover them later.
        From the crypto specification's list of explicit non-guarantees:
      </p>
      <ul class="plain">
        <li>
          <strong>Availability.</strong> A malicious or broken server can refuse, delete, or delay.
          The CLI detects and warns; it cannot prevent.
        </li>
        <li>
          <strong>Correctness of values.</strong> An authorized member can write a wrong value. The
          server cannot check what it cannot read.
        </li>
        <li>
          <strong>Un-reading.</strong> Encryption cannot take back a value someone has already
          decrypted. Rotate, don't rely on revocation.
        </li>
        <li>
          <strong>Lost keys.</strong> Your master key lives on your devices and in your recovery code.
          We cannot restore what we never had.
        </li>
      </ul>
      <p class="fine">
        The full list, with the reasoning, is in the
        <a href={`${cryptoSpec}#143-明示的な非保証v1`}>crypto specification, §14.3</a> (Japanese).
        No telemetry anywhere: the CLI, the installer, the dashboard, and this page send nothing to
        third parties.
      </p>
    </section>

    <section class="section" id="start" aria-labelledby="start-heading">
      <h2 id="start-heading">Get started</h2>
      <p>
        Releases are pre-release tags until <code>v0.1.0</code>. Pick the latest tag on the
        <a href={`${repo}/releases`}>Releases page</a>, and read the script before running it — this
        is a secrets manager.
      </p>
      <pre class="terminal"><code><span class="comment"># 1. Install the CLI (Linux / macOS; Bun not required)</span>
V=&lt;latest-tag&gt;
curl -fsSL "https://raw.githubusercontent.com/maruhiapp/maruhi/$&lbrace;V&rbrace;/packaging/install.sh" -o maruhi-install.sh
less maruhi-install.sh
sh maruhi-install.sh --version "$&lbrace;V&rbrace;"

<span class="comment"># 2. Point it at a server and sign in</span>
maruhi config set server {productOrigin}
maruhi login
<span class="out">Confirmation code: PX7Q-4MRH</span></code></pre>
      <p>
        <code>maruhi login</code> opens your browser for a GitHub sign-in and shows the same
        confirmation code in both places. Compare them, approve, and you are in. The first time,
        <code>maruhi key generate</code> creates your master key and a recovery code — that is the one
        ceremony zero knowledge asks of you.
      </p>
      <p class="fine">
        Prebuilt binaries with checksums, Homebrew (from <code>v0.1.0</code>), and npm
        (<code>bun install -g maruhi@next</code>) are in the
        <a href={`${repo}#install-cli`}>README</a>.
      </p>

      <h3 id="access">Access</h3>
      <p>
        The hosted service at <a href={productOrigin}>my.maruhi.app</a> is in <strong>private
        preview</strong>. Creating an account needs an invite code, which the sign-in page asks for. A
        waitlist opens with the invite-only beta; until then, follow the repository for release
        notes. Or skip the queue and run it on your own account.
      </p>
      <!-- waitlist 導線の置き場(H6 で Workers への POST フォームに差し替える — 静的文言のみ) -->
      <p class="actions" data-waitlist-placeholder>
        <a class="button" href={`${repo}/releases`}>Watch releases on GitHub</a>
        <a class="link" href="/docs/self-hosting">Self-host instead</a>
      </p>
    </section>

    <footer class="footer">
      <p>
        <a href={repo}>GitHub</a> · <a href="/docs">Docs</a> ·
        <a href={`${repo}/blob/main/LICENSE.md`}>License</a> (FSL-1.1-MIT for the server and web,
        MIT for the CLI and crypto)
      </p>
      <p class="fine">
        No analytics, no trackers, no third-party scripts. Type set in
        <a href="/fonts/OFL-Archivo.txt">Archivo</a> and
        <a href="/fonts/OFL-MartianMono.txt">Martian Mono</a> (SIL Open Font License 1.1), served
        from this site. The ㊙ mark derives from Noto Sans CJK JP (SIL OFL 1.1).
      </p>
    </footer>
  </div>
</PageLayout>

<style>
  .lp {
    --lp-measure: 44rem;
    --lp-wide: 64rem;
    --lp-gutter: 1.5rem;
    --lp-gap: 1rem;
    --lp-section: 4.5rem;
    --lp-hero-size: clamp(2.5rem, 6vw, 4.25rem);
    --lp-h2-size: clamp(1.5rem, 3vw, 2rem);
    --lp-terminal-size: 0.875rem;
    --lp-border: 1px;
    --lp-button-pad: 0.75rem 1.25rem;

    margin: 0 auto;
    padding: 0 var(--lp-gutter) var(--lp-section);
    max-width: var(--lp-wide);
    color: var(--blume-foreground);
    font-family: var(--blume-font-body);
    line-height: 1.6;
  }

  .section,
  .hero,
  .footer {
    padding-top: var(--lp-section);
  }

  .hero h1 {
    margin: 0 0 var(--lp-gap);
    font-family: var(--blume-font-display);
    font-size: var(--lp-hero-size);
    font-weight: 800;
    /* Archivo の幅軸 — 見出しは幅広・極太で作る(web-design-pass.md §4) */
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: var(--lp-measure);
  }

  /* アクセントは限定的に: 見出しの決め台詞と CTA ボタンのみ(§2) */
  .hero .punch {
    display: block;
    color: var(--blume-accent);
  }

  .eyebrow {
    margin: 0 0 var(--lp-gap);
    font-family: var(--blume-font-mono);
    font-size: var(--lp-terminal-size);
    color: var(--blume-muted-foreground);
  }

  .lede {
    margin: 0 0 calc(var(--lp-gap) * 2);
    max-width: var(--lp-measure);
    font-size: 1.125rem;
    color: var(--blume-muted-foreground);
  }

  h2 {
    margin: 0 0 var(--lp-gap);
    font-family: var(--blume-font-display);
    font-size: var(--lp-h2-size);
    font-weight: 700;
    font-stretch: 105%;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  h3 {
    margin: calc(var(--lp-gap) * 2) 0 calc(var(--lp-gap) / 2);
    font-family: var(--blume-font-display);
    font-size: 1.125rem;
    font-weight: 700;
  }

  p {
    margin: 0 0 var(--lp-gap);
    max-width: var(--lp-measure);
  }

  .fine {
    font-size: 0.875rem;
    color: var(--blume-muted-foreground);
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--blume-border);
    text-underline-offset: 0.15em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  code {
    font-family: var(--blume-font-mono);
    font-size: 0.9em;
    background: var(--blume-code-background);
    border: var(--lp-border) solid var(--blume-border);
    border-radius: calc(var(--blume-radius) / 2);
    padding: 0 0.35em;
  }

  /* ターミナル: コードが主役(§2)。背景は code token、枝葉の装飾は付けない */
  .terminal {
    margin: 0 0 calc(var(--lp-gap) * 1.5);
    padding: var(--lp-gap) calc(var(--lp-gap) * 1.25);
    max-width: var(--lp-measure);
    overflow-x: auto;
    font-family: var(--blume-font-mono);
    font-size: var(--lp-terminal-size);
    line-height: 1.7;
    color: var(--blume-foreground);
    background: var(--blume-code-background);
    border: var(--lp-border) solid var(--blume-border);
    border-radius: var(--blume-radius);
  }

  .terminal code {
    font-size: inherit;
    background: none;
    border: 0;
    padding: 0;
  }

  .terminal .prompt {
    color: var(--blume-accent);
    user-select: none;
  }

  .terminal .out,
  .terminal .comment {
    color: var(--blume-muted-foreground);
  }

  .terminal .err {
    color: var(--blume-foreground);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lp-gap);
    align-items: center;
  }

  .button {
    display: inline-block;
    padding: var(--lp-button-pad);
    font-weight: 600;
    text-decoration: none;
    color: var(--blume-accent-foreground);
    background: var(--blume-accent);
    border-radius: var(--blume-radius);
  }

  .button:hover {
    filter: brightness(1.08);
  }

  .link {
    font-weight: 600;
  }

  /* 信頼境界の表: 装飾はしない。yes / no だけを目で拾えるようにする */
  .table-wrap {
    overflow-x: auto;
    margin: 0 0 var(--lp-gap);
  }

  .trust {
    width: 100%;
    max-width: var(--lp-wide);
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .trust th,
  .trust td {
    text-align: left;
    vertical-align: top;
    padding: calc(var(--lp-gap) * 0.7) var(--lp-gap);
    border-top: var(--lp-border) solid var(--blume-border);
  }

  .trust thead th {
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--blume-muted-foreground);
    border-top: 0;
  }

  .trust tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .trust td.yes,
  .trust td.no {
    font-family: var(--blume-font-mono);
    white-space: nowrap;
  }

  .trust td.no {
    color: var(--blume-muted-foreground);
  }

  .trust td:last-child {
    color: var(--blume-muted-foreground);
  }

  .plain {
    margin: 0 0 var(--lp-gap);
    padding: 0;
    list-style: none;
    max-width: var(--lp-measure);
  }

  .plain li {
    padding: calc(var(--lp-gap) * 0.7) 0;
    border-top: var(--lp-border) solid var(--blume-border);
  }

  .footer {
    border-top: var(--lp-border) solid var(--blume-border);
    margin-top: var(--lp-section);
    padding-top: calc(var(--lp-gap) * 2);
    font-size: 0.9rem;
    color: var(--blume-muted-foreground);
  }
</style>
