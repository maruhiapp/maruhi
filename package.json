{
  "name": "maruhi",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run check:english && bun run fmt:check && bun run lint && bun run typecheck && bun run importlint && bun run fallow:audit && bun run fallow:baselines && bun run doctor && bun run test",
    "check:english": "bun scripts/check-english.mjs --all",
    "doctor": "bun run --filter @maruhi/web doctor",
    "fallow:audit": "fallow audit",
    "fallow:baselines": "fallow --baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json --baseline-mode identity --fail-on-stale-baseline",
    "fallow:baseline": "fallow dead-code --save-baseline fallow-baselines/dead-code.json && fallow health --save-baseline fallow-baselines/health.json --baseline-mode identity && fallow dupes --save-baseline fallow-baselines/dupes.json --threshold 0 && bun scripts/check-dupes-baseline.mjs --restore HEAD",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "importlint": "import-lint",
    "lint": "vp lint --deny-warnings",
    "prepare": "effect-tsgo patch --oxlint --no-typescript && bun run --filter @maruhi/site sync",
    "test": "vitest run",
    "test:app-unit": "bun scripts/test-suite.mjs run app-unit",
    "test:cli": "bun scripts/test-suite.mjs run cli",
    "test:packages": "bun scripts/test-suite.mjs run packages",
    "test:server": "bun scripts/test-suite.mjs run server",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.68.1",
    "@import-lint/cli": "0.1.10",
    "@stylexjs/eslint-plugin": "0.19.2",
    "fallow": "3.42.0",
    "oxlint-plugin-eslint": "1.93.0",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@cloudflare/config>zod": "4.6.6",
    "@cloudflare/vitest-plugin>zod": "4.6.6",
    "@scalar/json-magic>undici": "7.30.1",
    "@types/node": "26.6.6",
    "@vercel/cli-config>zod": "4.6.6",
    "miniflare>undici": "7.30.1",
    "satori>fflate": "0.7.5"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
