{
  "name": "maruhi",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run check:english && bun run fmt:check && bun run lint && bun run typecheck && bun run lint:effect && bun run importlint && bun run fallow:audit && bun run fallow:baselines && bun run doctor && bun run test",
    "check:english": "bun scripts/check-english.mjs --all",
    "doctor": "bun run --filter @maruhi/web doctor",
    "fallow:audit": "fallow audit",
    "fallow:baselines": "fallow --baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json --baseline-mode identity --fail-on-stale-baseline",
    "fallow:baseline": "fallow dead-code --save-baseline fallow-baselines/dead-code.json && fallow health --save-baseline fallow-baselines/health.json --baseline-mode identity && fallow dupes --save-baseline fallow-baselines/dupes.json && bun scripts/check-dupes-baseline.mjs --restore HEAD",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "importlint": "import-lint",
    "lint": "oxlint",
    "lint:effect": "bun scripts/effect-diagnostics.mjs",
    "test": "vitest run",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@import-lint/cli": "0.1.10",
    "fallow": "3.32.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-eslint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@scalar/json-magic>undici": "7.29.1",
    "@types/node": "26.6.4",
    "lodash-es": "4.18.1",
    "miniflare>undici": "7.29.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
