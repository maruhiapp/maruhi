{
  "description": "Vectors for CRYPTO_SPEC §2.1's length-prefixed encoding (uint32-BE length + UTF-8 body)",
  "cases": [
    {
      "name": "ambiguity-ab-c",
      "fields": ["ab", "c"],
      "expected_hex": "0000000261620000000163",
      "note": "The point: identical to the next ambiguity-a-bc under raw string concatenation, but different under LP"
    },
    {
      "name": "ambiguity-a-bc",
      "fields": ["a", "bc"],
      "expected_hex": "0000000161000000026263"
    },
    {
      "name": "empty-field",
      "fields": [""],
      "expected_hex": "00000000",
      "note": "an empty field is just 00000000"
    },
    {
      "name": "empty-list",
      "fields": [],
      "expected_hex": "",
      "note": "zero fields = the empty byte string"
    },
    {
      "name": "utf8-multibyte",
      "fields": ["㊙"],
      "expected_hex": "00000003e38a99",
      "note": "UTF-8 multibyte (3 bytes)"
    },
    {
      "name": "number-decimal",
      "fields": ["epoch", "42"],
      "expected_hex": "0000000565706f6368000000023432",
      "note": "numbers are stringified in decimal (42 → \"42\")"
    },
    {
      "name": "aad-shape-example",
      "fields": ["maruhi/v1", "proj-0001", "env-prod-0001", "3", "var-database-url-0001", "7"],
      "expected_hex": "000000096d61727568692f76310000000970726f6a2d303030310000000d656e762d70726f642d303030310000000133000000157661722d64617461626173652d75726c2d303030310000000137",
      "note": "the same byte string as the AAD of variable-encryption.json's basic vector"
    }
  ]
}
