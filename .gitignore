node_modules/
dist/
dist-npm/
coverage/
*.tsbuildinfo

# Cloudflare
.wrangler/
.cloudflare/
.dev.vars
# Generated by `cf dev` / `cf workers types` from cloudflare.config.ts
worker-configuration.d.ts

# fallow's local cache (the committed baselines are fallow-baselines/)
.fallow/

# The Homebrew formula is a generated artifact (apps/cli/scripts/
# generate-formula.ts builds it from the Release checksums.txt and copies it
# to the tap repository — docs/RELEASING.md).
# packaging/homebrew/maruhi.example.rb is committed as a shape example
packaging/homebrew/maruhi.rb

# Astro's generated types/cache, the Nimbus integration's generated
# page-collections cache, and the built site (apps/site — astro dev /
# build recreates them)
apps/site/.astro/
apps/site/.nimbus/
apps/site/dist/

# Dashboard screenshots (output of apps/web/test/screenshots.ts — temporary
# files for attaching to PRs)
apps/web/screenshots/
# Vitest's artifact directory: browser-mode failure screenshots and any report
# a local run writes (a byproduct — the suite does not consume them)
.vitest/
