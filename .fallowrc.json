{
  "$schema": "./node_modules/fallow/schema.json",
  // CLI / lint 設定からのみ参照されるツールは import されないため未使用依存から除外する
  // (@stylexjs/unplugin と @stylexjs/eslint-plugin は @astryxdesign/build / oxlint 設定からの間接参照)
  "ignoreDependencies": [
    "@import-lint/cli",
    "oxlint-plugin-eslint",
    "@stylexjs/unplugin",
    "@stylexjs/eslint-plugin"
  ],
  // apps/web のエントリは vite.config.ts の文字列参照(funstackStatic の root/app)のため
  // fallow が自動検出できない。手動でエントリポイントとして宣言する
  // theme/maruhi.js は astryx theme build の生成物。import 指定子 ../../theme/maruhi.js を
  // fallow は TS 流儀で maruhi.ts に解決するため、実体の .js が未到達と誤検出される。
  // vitest.unit.config.ts(web ユニットテスト)は規約外のファイル名(vitest.config.ts は
  // e2e が使用済み)でルート vitest.config.ts から文字列参照されるため自動検出されない。
  // apps/server/scripts は運営者が bun run で直接叩く運用スクリプト(サインアップ招待
  // コードの発行 — AUTH_SPEC §3)で、製品コードから import されないため手動宣言する。
  // apps/server/src/restore-worker.ts は wrangler.restore.jsonc の main(復元 worker —
  // docs/notes/hosted-ops.md §2-E)で、index.ts から import されない別エントリ
  "entry": [
    "apps/web/src/Root.tsx",
    "apps/web/src/App.tsx",
    "apps/web/scripts/*.ts",
    "apps/web/theme/maruhi.js",
    "apps/web/vitest.unit.config.ts",
    "apps/web/test/unit/*.test.ts",
    "apps/server/scripts/*.ts",
    "apps/server/src/restore-worker.ts"
  ],
  // エージェントスキル(ベンダードコンテンツ)、deepsec 隔離ワークスペース、
  // テストベクターの参照生成・検証ツール(使い捨て。製品コードから import されない)は解析対象外。
  // apps/web/public は SPA 外の静的配信アセット(invite.html から参照される invite.css 等 —
  // AUTH_SPEC §15-3)で、モジュールグラフに載らないため未到達と誤検出される
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".deepsec/**",
    "apps/web/public/**",
    "packages/crypto/test-vectors/tools/**"
  ],
  "audit": {
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  }
}
