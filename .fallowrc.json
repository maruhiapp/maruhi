{
  "$schema": "./node_modules/fallow/schema.json",
  // Tools referenced only from CLI / lint config are never imported, so they
  // are excluded from unused-dependency checks
  // (@stylexjs/unplugin and @stylexjs/eslint-plugin are referenced indirectly
  // via @astryxdesign/build / the oxlint config)
  "ignoreDependencies": [
    "@import-lint/cli",
    "oxlint-plugin-eslint",
    "@stylexjs/unplugin",
    "@stylexjs/eslint-plugin"
  ],
  // apps/web's entries are string references inside vite.config.ts
  // (funstackStatic's root/app), so fallow cannot detect them automatically —
  // declare them as entry points manually.
  // theme/maruhi.js is a product of the astryx theme build. fallow resolves
  // the import specifier ../../theme/maruhi.js to maruhi.ts in the TS idiom,
  // which would falsely flag the real .js as unreachable.
  // vitest.unit.config.ts (web unit tests) uses a non-conventional filename
  // (vitest.config.ts is taken by e2e) and is referenced by string from the
  // root vitest.config.ts, so it is not auto-detected.
  // apps/server/scripts are ops scripts operators run directly via bun run
  // (issuing signup invite codes — AUTH_SPEC §3); product code never imports
  // them, so they are declared manually.
  // apps/server/src/restore-worker.ts is the `main` of wrangler.restore.jsonc
  // (the restore worker — docs/notes/hosted-ops.md §2-E), a separate entry not
  // imported from index.ts.
  // apps/site: the Blume CLI reads blume.config.ts and scripts/ are invoked
  // directly via bun run.
  // apps/site/test/unit/shims are fake vendor CLIs launched over PATH by the
  // docs recipe checks (recipes.test.ts) (the bin/ sh wrappers run them under
  // bun); never imported, so declared manually.
  // apps/cli/test/support/exec-probe.ts is a real-process probe that
  // live-exec.test.ts launches with `bun` (to inspect Bun.spawn from Node-side
  // vitest) — likewise never imported
  "entry": [
    "apps/web/src/Root.tsx",
    "apps/web/src/App.tsx",
    "apps/web/scripts/*.ts",
    "apps/web/theme/maruhi.js",
    "apps/web/vitest.unit.config.ts",
    "apps/web/test/unit/*.test.ts",
    "apps/server/scripts/*.ts",
    "apps/server/src/restore-worker.ts",
    "apps/site/blume.config.ts",
    "apps/site/scripts/*.ts",
    "apps/site/vitest.unit.config.ts",
    "apps/site/test/unit/*.test.ts",
    "apps/site/test/unit/shims/*.ts",
    "apps/cli/test/support/exec-probe.ts"
  ],
  // Out of analysis scope: agent skills (vendored content), the deepsec
  // isolated workspace, the test-vector reference generation/verification
  // tools (throwaway; never imported by product code), and scripts/ —
  // standalone repo tooling run via bun, never imported.
  // apps/web/public holds statically served assets outside the SPA (e.g.
  // invite.css referenced by invite.html — AUTH_SPEC §15-3); they sit off the
  // module graph and would be falsely flagged unreachable.
  // For apps/site (Blume), blume.config.ts is the entry read by the Blume CLI,
  // and .astro / .mdx plus public/ static assets are off the module graph.
  // .blume/ is Blume's generated runtime (gitignored)
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".deepsec/**",
    "apps/web/public/**",
    "apps/site/public/**",
    "apps/site/docs/**",
    "apps/site/pages/**",
    "apps/site/.blume/**",
    "apps/site/.blume-verify/**",
    "packages/crypto/test-vectors/tools/**",
    "scripts/**"
  ],
  "audit": {
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  }
}
