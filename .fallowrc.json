{
  "$schema": "./node_modules/fallow/schema.json",
  // The newest keys below (the rules new in fallow 3.34) need fallow 3.34 or
  // later; an older binary names the upgrade instead of failing on an unknown
  // key
  "minimumVersion": "3.34.0",
  // A file fallow cannot parse drops out of every detector, the boundaries
  // below included, so a parse failure fails the run instead of only warning
  "failOnParseError": true,
  // Tools referenced only from CLI / lint config are never imported, so they
  // are excluded from unused-dependency checks
  // (@stylexjs/unplugin and @stylexjs/eslint-plugin are referenced indirectly
  // via @astryxdesign/build / the oxlint config in vite.config.ts;
  // @effect/tsgo supplies the effecttsgo oxlint preset that vite.config.ts
  // imports and the patched tsgolint the root `prepare` script applies)
  "ignoreDependencies": [
    "@effect/tsgo",
    "@import-lint/cli",
    "oxlint-plugin-eslint",
    "@stylexjs/unplugin",
    "@stylexjs/eslint-plugin"
  ],
  // The scoped overrides in package.json are security pins, not leftovers:
  // they lift exact-pinned copies to patched releases so `bun audit` stays
  // clean. undici 7.29.1 becomes 7.30.1 in every miniflare copy (the one
  // wrangler and @cloudflare/vitest-plugin share, and the ones nested under
  // cf and @cloudflare/runtime-types) and in @scalar/json-magic; zod 4.6.5
  // (@cloudflare/config, @cloudflare/vitest-plugin) and 4.1.11
  // (@vercel/cli-config) become 4.6.6. fallow reports them as unused because
  // it cannot see the transitive resolution; bun.lock shows each in effect.
  // Each holds its copy at that exact version, so remove an override and its
  // entry here once a dependency update brings the dependent's own pin to
  // the patched version or later.
  "ignoreDependencyOverrides": [
    { "package": "@cloudflare/config>zod", "source": "package.json" },
    { "package": "@cloudflare/vitest-plugin>zod", "source": "package.json" },
    { "package": "@scalar/json-magic>undici", "source": "package.json" },
    { "package": "@vercel/cli-config>zod", "source": "package.json" },
    { "package": "miniflare>undici", "source": "package.json" }
  ],
  // apps/web's entries are string references inside vite.config.ts
  // (funstackStatic's root/app), so fallow cannot detect them automatically —
  // declare them as entry points manually.
  // theme/maruhi.js is a product of the astryx theme build. fallow resolves
  // the import specifier ../../theme/maruhi.js to maruhi.ts in the TS idiom,
  // which would falsely flag the real .js as unreachable.
  // vitest.unit.config.ts (web unit tests) uses a non-conventional filename
  // (vitest.config.ts is taken by e2e) and is referenced by string from the
  // root vitest.config.ts, so it is not auto-detected.
  // apps/server/scripts are ops scripts operators run directly via bun run
  // (issuing signup invite codes — AUTH_SPEC §3); product code never imports
  // them, so they are declared manually.
  // apps/server/src/restore-worker.ts is the entrypoint of the `restore`
  // mode in cloudflare.config.ts (the restore worker — docs/notes/hosted-ops.md
  // §2-E), a separate entry not imported from index.ts.
  // apps/site: the Blume CLI reads blume.config.ts, scripts/ are invoked
  // directly via bun run, and cloudflare.config.ts / wrangler.config.ts are
  // the cf deploy / bundler shim configs read by the CLIs themselves.
  // apps/site/test/unit/shims are fake vendor CLIs launched over PATH by the
  // docs recipe checks (recipes.test.ts) (the bin/ sh wrappers run them under
  // bun); never imported, so declared manually.
  // apps/cli/scripts are release tooling that installer.yml / release.yml
  // run directly with bun (the smoke matrix, the Homebrew formula); never
  // imported, so declared manually.
  // apps/cli/test/support/exec-probe.ts / run-probe.ts / pipe-probe.ts /
  // proxy-probe.ts are real-process probes that live-exec / live-run /
  // live-proxy.test.ts launch
  // with `bun` (to inspect Bun.spawn and the proxy under Bun from Node-side
  // vitest), and import-trace.ts is the preload startup-loads.test.ts passes
  // to `bun --preload` — likewise never imported
  "entry": [
    "apps/web/src/Root.tsx",
    "apps/web/src/App.tsx",
    "apps/web/scripts/*.ts",
    "apps/web/theme/maruhi.js",
    "apps/web/vitest.unit.config.ts",
    "apps/web/test/unit/*.test.ts",
    "apps/server/scripts/*.ts",
    "apps/server/src/restore-worker.ts",
    "apps/site/blume.config.ts",
    "apps/site/cloudflare.config.ts",
    "apps/site/wrangler.config.ts",
    "apps/site/scripts/*.ts",
    "apps/site/vitest.unit.config.ts",
    "apps/site/test/unit/*.test.ts",
    "apps/site/test/unit/shims/*.ts",
    "apps/cli/scripts/*.ts",
    "apps/cli/test/support/exec-probe.ts",
    "apps/cli/test/support/import-trace.ts",
    "apps/cli/test/support/run-probe.ts",
    "apps/cli/test/support/pipe-probe.ts",
    "apps/cli/test/support/proxy-probe.ts"
  ],
  // Out of analysis scope: agent skills (vendored content), the deepsec
  // isolated workspace, the test-vector reference generation/verification
  // tools (throwaway; never imported by product code), and scripts/ —
  // standalone repo tooling run via bun, never imported.
  // apps/web/public holds statically served assets outside the SPA (e.g.
  // pages.css referenced by invite.html — AUTH_SPEC §15-3); they sit off the
  // module graph and would be falsely flagged unreachable.
  // For apps/site (Blume), blume.config.ts is the entry read by the Blume CLI,
  // and .astro / .mdx plus public/ static assets are off the module graph.
  // .blume/ is Blume's generated runtime (gitignored)
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".deepsec/**",
    "apps/web/public/**",
    "apps/site/public/**",
    "apps/site/docs/**",
    "apps/site/pages/**",
    "apps/site/.blume/**",
    "apps/site/.blume-verify/**",
    "packages/crypto/test-vectors/tools/**",
    "scripts/**"
  ],
  // Layer structure, mirrored in CLAUDE.md ("Layers"). Workspace packages sit
  // below the apps: crypto imports no other workspace package, core may import
  // crypto, api-schema may import core and crypto. Packages never import an
  // app, and apps (cli, server, web, site) never import each other.
  // Per app: the CLI entry files sit above the command layer (commands/** and
  // each *.package/command.ts), which sits above every other file (the domain
  // layer); domain files may import the entry files only for types. Server's
  // index.ts is the only file that imports handlers/**. Web's shell (App.tsx,
  // Root.tsx, pages/**) may import the views, never the reverse.
  // Zones match in order, first match wins — the per-app `src/**` catch-alls
  // must stay last in their group.
  "boundaries": {
    "zones": [
      { "name": "crypto", "patterns": ["packages/crypto/src/**"] },
      { "name": "core", "patterns": ["packages/core/src/**"] },
      { "name": "api-schema", "patterns": ["packages/api-schema/src/**"] },
      {
        "name": "cli-entry",
        "patterns": [
          "apps/cli/src/bin.ts",
          "apps/cli/src/index.ts",
          "apps/cli/src/cli.ts",
          "apps/cli/src/cli-runner.ts"
        ]
      },
      {
        "name": "cli-commands",
        "patterns": ["apps/cli/src/commands/**", "apps/cli/src/*.package/command.ts"]
      },
      { "name": "cli-domain", "patterns": ["apps/cli/src/**"] },
      { "name": "server-entry", "patterns": ["apps/server/src/index.ts"] },
      { "name": "server-handlers", "patterns": ["apps/server/src/handlers/**"] },
      { "name": "server-domain", "patterns": ["apps/server/src/**"] },
      {
        "name": "web-shell",
        "patterns": ["apps/web/src/App.tsx", "apps/web/src/Root.tsx", "apps/web/src/pages/**"]
      },
      { "name": "web-views", "patterns": ["apps/web/src/**"] },
      { "name": "site", "patterns": ["apps/site/**"] }
    ],
    "rules": [
      { "from": "crypto", "allow": [] },
      { "from": "core", "allow": ["crypto"] },
      { "from": "api-schema", "allow": ["core", "crypto"] },
      {
        "from": "cli-entry",
        "allow": ["cli-commands", "cli-domain", "crypto", "core", "api-schema"]
      },
      {
        "from": "cli-commands",
        "allow": ["cli-commands", "cli-domain", "crypto", "core", "api-schema"]
      },
      {
        "from": "cli-domain",
        "allow": ["cli-domain", "crypto", "core", "api-schema"],
        "allowTypeOnly": ["cli-entry"]
      },
      {
        "from": "server-entry",
        "allow": ["server-handlers", "server-domain", "crypto", "core", "api-schema"]
      },
      {
        "from": "server-handlers",
        "allow": ["server-handlers", "server-domain", "crypto", "core", "api-schema"]
      },
      { "from": "server-domain", "allow": ["server-domain", "crypto", "core", "api-schema"] },
      { "from": "web-shell", "allow": ["web-shell", "web-views", "crypto", "core", "api-schema"] },
      { "from": "web-views", "allow": ["web-views", "crypto", "core", "api-schema"] },
      { "from": "site", "allow": ["site", "crypto", "core", "api-schema"] }
    ]
  },
  // Clone detection skips the crypto test harnesses: each
  // packages/crypto/test/checks/<section>.ts is a per-spec-section harness kept
  // independently readable against its CRYPTO_SPEC section, and deduplicating
  // them would change packages/crypto, which needs crypto human review
  // (CLAUDE.md). It also skips the theme files `astryx theme build` generates
  // from apps/web/theme/maruhi.ts (maruhi.css and maruhi.js, both marked
  // @generated): nobody edits them, so a repeat there is not code to share.
  // ignoredClones lists clone groups reviewed and kept, by the key fallow
  // reports; a change to either copy, or a third copy, gives a new key that
  // is reported again. fallow says nothing about a key that matches no
  // clone, so a change that removes a kept clone removes its key and note:
  // - dup:cfe4b53c:2 is apps/cli/src/values-verify.ts's
  //   verifyVariableStatements and verifyDeclaredStatements. Each checks its
  //   own §12-7 list, and the two refuse different things: the metadata-only
  //   list refuses only a deleted statement, after the signature check; the
  //   declared list refuses every status but declared (an active one is a
  //   value omission — CRYPTO_SPEC §6.3), before the signature check, and
  //   also an ID the active list holds. One shared loop would need a switch
  //   for each difference, the order of the checks included.
  // The duplication baseline (fallow-baselines/dupes.json) holds only real
  // debt and is shrink-only (scripts/check-dupes-baseline.mjs, CI 5b).
  // fallow reports a clone group at warn, which fails neither `fallow
  // audit` (CI 5) nor the whole-project run (`fallow:baselines` in
  // package.json: CI 5a and `bun run check`). threshold fails both on any
  // clone group the baseline does not list instead: it is the most
  // duplication allowed, as a share of the scanned lines in percent, and
  // the smallest clone fallow reports (two copies of 5 lines, minLines'
  // default) is 0.0066% of today's 151,000 lines. 0.0001 stays below one
  // such clone until the project passes ten million lines. fallow prints
  // the failure as "Duplication (0.0%) exceeds threshold (0.0%)", both
  // values rounded. fallow's default ignores leave spec files
  // (`**/*.test.*`) out of clone detection, and so out of this gate.
  // `bun run fallow:baseline` saves the baseline with `--threshold 0`:
  // under the threshold the save would exit 1 on a clone and stop the
  // chain before the shrink-only restore
  "duplicates": {
    "ignore": [
      "packages/crypto/test/checks/**",
      "apps/web/theme/maruhi.css",
      "apps/web/theme/maruhi.js"
    ],
    "ignoredClones": ["dup:cfe4b53c:2"],
    "threshold": 0.0001
  },
  // Owner ruling 2026-10-06 (CLAUDE.md "No backward compatibility before the
  // first public release"): nothing may be kept around for older data,
  // clients or servers. A still-consumed `@deprecated` export is such a
  // leftover, so it fails the gate (an unconsumed one already fails as an
  // unused export). Revisit at the first public release, when deprecating
  // before removal becomes legitimate
  "rules": {
    "deprecated-exports-in-use": "error",
    // Rules new in fallow 3.34 that default to warn, promoted so they gate.
    // The Effect dead-code rules run in every dead-code pass. The audit
    // diff-risk rules read only the diff against the base, so main never has
    // findings; a deliberate change acknowledges one with a reasoned line
    // above it, e.g. `// fallow-ignore-next-line added-suppression -- <why>`
    // before a new suppression comment
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error"
  },
  "audit": {
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json",
    // Every error-level finding in a changed file fails the audit,
    // inherited or not, and the base-snapshot attribution pass is skipped
    // (owner decision 2026-10-24, once the clone groups reached zero). A
    // complexity finding in a changed non-test file fails whether or not
    // the change made it worse, so there is no `worsened` setting (it has
    // no effect under `all`); in a test file the audit only warns, and the
    // whole-project run (CI 5a) fails on it unless the health baseline
    // lists it. The diff-risk rules above still read the diff, and the
    // duplicates threshold above fails a clone group
    "gate": "all"
  }
}
